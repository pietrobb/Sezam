{
  "about": "The client rotates the account's identity while T is shared with bob; the ref takes the new keys over, bob accepts the new fingerprint and still reads T.",
  "steps": [
    {"on": "ref", "do": "create_folder", "name": "T"},
    {"on": "ref", "do": "create_entry", "name": "t1", "folder": "T", "password": "a"},
    {"on": "ref", "do": "sync"},
    {"on": "ref", "do": "invite", "member": "bob"},
    {"on": "ref", "do": "grant", "member": "bob", "folder": "T"},
    {"on": "ref", "do": "sync"},
    {"on": "client", "do": "sync"},
    {"on": "client", "do": "rotate_identity"},
    {"on": "client", "do": "sync"},
    {"on": "client", "do": "edit_entry", "name": "t1", "password": "b"},
    {"on": "client", "do": "sync"},
    {"on": "ref", "do": "sync"},
    {"on": "ref", "do": "create_entry", "name": "t2", "folder": "T", "password": "c"},
    {"on": "ref", "do": "sync"},
    {"on": "bob", "do": "reads", "expect": {"T": null, "T/t1": "b", "T/t2": "c"}}
  ],
  "expect": {"T": null, "T/t1": "b", "T/t2": "c"}
}
