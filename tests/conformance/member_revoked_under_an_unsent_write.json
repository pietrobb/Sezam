{
  "about": "The client writes in T, unsent (under T's key), while the ref revokes bob and re-keys T; the client's write and its next one reach everyone under the new key, bob holds no key to anything live.",
  "steps": [
    {"on": "ref", "do": "create_folder", "name": "T"},
    {"on": "ref", "do": "create_entry", "name": "t1", "folder": "T", "password": "a"},
    {"on": "ref", "do": "sync"},
    {"on": "ref", "do": "invite", "member": "bob"},
    {"on": "ref", "do": "grant", "member": "bob", "folder": "T"},
    {"on": "ref", "do": "sync"},
    {"on": "bob", "do": "reads", "expect": {"T": null, "T/t1": "a"}},
    {"on": "client", "do": "sync"},
    {"on": "client", "do": "create_entry", "name": "t2", "folder": "T", "password": "b"},
    {"on": "ref", "do": "revoke", "member": "bob"},
    {"on": "ref", "do": "sync"},
    {"on": "client", "do": "sync"},
    {"on": "client", "do": "create_entry", "name": "t3", "folder": "T", "password": "c"},
    {"on": "client", "do": "edit_entry", "name": "t1", "password": "d"},
    {"on": "client", "do": "sync"},
    {"on": "bob", "do": "sync"}
  ],
  "expect": {"T": null, "T/t1": "d", "T/t2": "b", "T/t3": "c"},
  "revoked": ["bob"]
}
